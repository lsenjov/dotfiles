#!/usr/bin/env bash

set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
  printf 'Usage: %s --check | --apply [PACKAGE ...]\n' "${0##*/}"
}

case "${1:-}" in
  --check)
    shift
    exec "$repo_root/scripts/doctor" "$@"
    ;;
  --apply)
    shift
    "$repo_root/scripts/doctor" --core-only --init-submodules
    exec "$repo_root/scripts/link" "$@"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
